# Copy to .env and fill in. Never commit .env.

# Required. Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional. Server ID for testing: slash commands sync there instantly instead of globally.
DEV_GUILD_ID=

# Optional. https://saucenao.com/user.php?page=search-api
# Without it, "Find source" only offers search-engine links.
SAUCENAO_API_KEY=

# Optional. https://nhentai.net/user/settings#apikeys
# nhentai cards work without it, but anonymous API use is limited to 20 galleries a minute (45 with a key).
NHENTAI_API_KEY=

# Optional. Where the SQLite database lives.
DATABASE_PATH=data/bb.sqlite

# Optional. How reposts look: "hidden" (just the preview) or "subtle" (a small "@user on Twitter" line).
# If previews ever stop showing up with "hidden", switch to "subtle" and restart.
LINK_STYLE=hidden

# Optional. DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional. Custom emojis BB uses in her lines, as Discord markup like <:bb_smug:123456789012345678>.
# Upload them under Developer Portal -> your app -> Emojis. Unset ones are simply left out.
EMOJI_BB_SMUG=
EMOJI_BB_ANNOYED=
EMOJI_BB_WINK=
